PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/dental_clinic
CORS_ORIGIN=http://localhost:3000

CLINIC_NAME=Dentfix
CLINIC_PHONE=+1-555-0142

# Your inbox — you get an email on every new booking
ADMIN_EMAIL=you@example.com
FROM_EMAIL=Dentfix <noreply@yourdomain.com>

# Option A: SendGrid (recommended for production)
SENDGRID_API_KEY=

# Option B: SMTP (Gmail, Outlook, Mailgun, etc.)
# Gmail example: enable 2FA, create an App Password, use smtp.gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# If neither SendGrid nor SMTP is set, dev mode uses Ethereal test mail
# and prints preview URLs in the backend console (not your real inbox).
